{
  "schemaVersion": 1,
  "description": "PHASE3 candidate-only discovery. Nothing here is auto-added to games.csv or published offers.",
  "enabled": true,
  "maxFirecrawlConcurrency": 2,
  "maxResultsPerQuery": 8,
  "queries": [
    {
      "id": "x-poikatsu",
      "query": "ポイ活 ゲーム 案件",
