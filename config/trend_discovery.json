        "x.com"
      ],
      "sourceType": "social"
    },
    {
      "id": "warau-new",
      "query": "ゲーム アプリ 新着 案件",
      "includeDomains": [
        "warau.jp"
      ],
      "sourceType": "point_site",
      "fallbackUrls": [
        "https://www.warau.jp/contents/point/category?category_group=77&display_style=list&page=1&point_group=2&sort=new"
      ]
    },
    {
      "id": "chobirich-new",
      "query": "ゲーム アプリ 案件",
      "includeDomains": [
        "chobirich.com"
      ],
      "sourceType": "point_site"
    },
    {
      "id": "coincome-new",
      "query": "ゲーム アプリ 案件",
      "includeDomains": [
        "cimcome.jp"
      ],
      "sourceType": "point_site",
      "fallbackUrls": [
        "https://cimcome.jp/campaigns"
      ]
    }
  ],
  "minimumScoreForReview": 30,
  "scheduleJST": "毎日 07:07 頃（GitHub Actions cron: 22:07 UTC）",
  "minimumScoreForResearch": 60,
  "minimumConfidenceForResearch": 70,
  "minimumSourcesForResearch": 2,
  "requirePointSiteEvidenceForResearch": true,
  "researchPromotion": "deterministic/API-free; writes data/research_queue.json only",
  "minimumVerifiedOffersForAdoption": 2,
  "minimumVerifiedSourcesForAdoption": 2,
  "adoptionGate": "API-free; strict same-offer verifier checks + complete collection; candidate output only",
  "productionAdoption": {
    "enabled": true,
    "requiresV29AdoptionReady": true,
    "revalidateBeforeWrite": true,
    "initialRefreshEnabled": false,
    "apiCalls": 0,
    "note": "V30 may add a verified game and its strict offers to production; scheduled refresh stays disabled until a controlled refresh policy is enabled."
  }
