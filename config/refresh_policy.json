{
  "schemaVersion": 1,
  "description": "PHASE2 daily automatic refresh and publication freshness policy.",
  "defaultRefreshHours": 24,
  "knownOfficialCacheSeconds": 1800,
  "maxFirecrawlConcurrency": 2,
  "maxKnownPageConcurrency": 2,
  "games": {
    "Township": {
      "enabled": true
    },
    "きのこ伝説": {
      "enabled": true
    },
    "メメントモリ": {
      "enabled": false
    },
    "ワーキングヒーロー": {
      "enabled": false
    },
    "ホワイトアウト・サバイバル": {
      "enabled": false,
      "adoptedBy": "V30",
      "reason": "new-game refresh remains disabled until controlled refresh policy is enabled"
    }
  },
  "publication": {
    "requireAutoPublishReady": true,
    "preservePreviousRowsOnTransientFailure": true,
    "exceptionQueue": true,
    "completeRunReplacesGameSnapshot": true,
    "degradedRunMergesOnly": true
  },
  "schedulerReady": true,
  "scheduleJST": "毎日 06:17 頃（GitHub Actions cron: 21:17 UTC）",
  "staleAfterHours": 48
}
