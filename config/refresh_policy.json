    "enabled": true,
    "mode": "candidate-only",
    "requireFirstPartyVerificationBeforePublication": true,
    "publishFromDiscovery": false,
    "baselineGame": "ワーキングヒーロー",
    "purpose": "Detect campaigns visible on comparison services but missing from POIGAME LAB; discovery hints never authorize publication."
